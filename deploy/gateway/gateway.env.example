# Variables del gateway universal (contenedor capsule-gateway). Copiar a deploy/gateway/gateway.env (modo 0600, fuera de git).
# TODAS las variables de este archivo existen en el binario (backend/internal/gateway/data/config.go, udp_config.go, take443.go):
# el nombre es el real y se comprobo con `capsule-gateway -check-config`. Lo que no esta aqui toma su valor por defecto del codigo.
# Los valores por defecto de este archivo son los de la primera fase (F1): el gateway NO toma el 443.

# --- Que escucha ---------------------------------------------------------------------------------------------------------------
# Listeners: "direccion[=tipo+tipo],...". Tipos: tls (SNI/ALPN: tunel capsule/1, rutas), pg-ssl (PostgreSQL clasico: SSLRequest), http, ssh.
# Sin "=tipo" acepta todos. F1: 5432 (PostgreSQL por SNI) y 8443 (pruebas y tunel capsule:// mientras el 443 sea de Caddy; el cliente usa
# CAPSULE_GATEWAY_PORT=8443 solo para esas pruebas). Cada puerto exige su regla en el security group (gateway.tf) y que ningun otro
# proceso del host lo use. MySQL/Redis/Mongo (G11) se anaden aqui con su puerto cuando existan.
CAPSULE_GW_LISTEN=[::]:5432=tls+pg-ssl,[::]:8443

# 443 COMPARTIDO CON CADDY (RUNBOOK-443.md). 0 = el gateway no escucha el 443 (F1). 1 = lo toma: ALPN capsule/1 o ruta por SNI se
# atienden aqui y CUALQUIER OTRO nombre (git.<zona>, etc.) pasa sin terminar TLS a Caddy. NO ponerlo a mano: lo fija
# docker-compose.take443.yml y lo orquesta switch-443.sh (Caddy debe soltar el 443 antes y publicar 127.0.0.1:8444).
CAPSULE_GW_TAKE_443=0
# Donde escucha el 443 (solo se cambia en pruebas locales sin root).
#CAPSULE_GW_443_ADDR=[::]:443
# Caddy detras del gateway (debe publicarlo en loopback: "127.0.0.1:8444:443"; NO 8443, que es el puerto de pruebas del gateway).
CAPSULE_GW_HTTP_UPSTREAM=127.0.0.1:8444
# 1 (defecto) antepone un encabezado PROXY protocol v2 con la IP real del cliente; exige Caddyfile.take443 (listener_wrappers proxy_protocol).
# Poner 0 SOLO si Caddy no lleva el wrapper (entonces Forgejo/Caddy veran la IP de loopback).
CAPSULE_GW_HTTP_UPSTREAM_PROXY=1
# Un hello TLS SIN SNI en el 443: close (defecto: se cierra tras el retardo uniforme) | upstream (se entrega a Caddy).
CAPSULE_GW_NO_SNI=close
# Nombres que NUNCA se entregan a Caddy aunque no tengan ruta (se cierran sin certificado: no se enumeran proyectos). Defecto:
# .db.<zona> y .db.<zona sin su primer nombre>. En produccion los nombres de base son <proyecto>.db.tumi-ai.com:
CAPSULE_GW_OWNED_SUFFIXES=.db.tumi-ai.com
# Reintenta cada 100 ms, hasta este plazo, un puerto aun ocupado en el arranque (Caddy en el 443; el gateway anterior si corre con otro
# uid). 0 = falla al arrancar. docker-compose.take443.yml lo pone en 10m: es lo que hace el traspaso sin hueco.
#CAPSULE_GW_BIND_RETRY=10m

# Pool de puertos aleatorios de respaldo (PLAN 3.4): "desde-hasta" o "off". Debe coincidir con gateway_pool_from/gateway_pool_to de
# gateway.tf (verify.sh lo comprueba). Distinto de 40000-41999 (puertos directos).
CAPSULE_GW_POOL=20000-29999

# Zona del punto de entrada del tunel: el gateway atiende tcp.<zona> y udp.<zona>. El cliente usa por defecto apps.tumi-ai.com
# (cli/pkg/gatewayclient: DefaultZone) => tcp.apps.tumi-ai.com, el nombre del certificado de sync-certs.sh y del Caddyfile.
# Por eso la zona es "apps.tumi-ai.com" y NO "tumi-ai.com" (con esta ultima el tunel quedaria en tcp.tumi-ai.com).
CAPSULE_GW_ZONE=apps.tumi-ai.com
# Nombres de tunel adicionales (separados por coma).
#CAPSULE_GW_TUNNEL_HOSTS=

# --- Plano de control ----------------------------------------------------------------------------------------------------------
# El backend publica 8080 en el host; el gateway (red del host) lo alcanza por loopback.
CAPSULE_GW_CONTROL_URL=http://127.0.0.1:8080
# Secreto compartido de /internal/gateway/routes y /internal/gateway/authorize (cabecera X-Gateway-Secret). Generar con
# `openssl rand -hex 32`; el MISMO valor en el backend (CAPSULE_GATEWAY_SECRET). No reutilizar CAPSULE_GIT_AUTH_SECRET.
# Alternativa: CAPSULE_GW_SECRET_FILE=/ruta (archivo montado).
CAPSULE_GW_SECRET=
# Tiempo que se sirven las rutas sin contacto con el control (6h; 0 = siempre), archivo con la ultima tabla y plazo de authorize.
#CAPSULE_GW_ROUTES_MAX_AGE=6h
#CAPSULE_GW_ROUTES_CACHE=/tmp/routes.json
#CAPSULE_GW_AUTH_TIMEOUT=3s
# Gracia para decisiones "allow" cacheadas si el control falla (0 = falla cerrado).
#CAPSULE_GW_AUTH_STALE=0s

# --- Certificados --------------------------------------------------------------------------------------------------------------
# (G9) Pares certificado/clave que carga el gateway, separados por coma y en el MISMO orden (el primero que admite el SNI gana; el comodin
# *.apps no cubre *.db). Los escribe deploy/gateway/acme-issue.sh (RUNBOOK-acme.md). SIGHUP o el cambio de fecha del archivo los recarga.
CAPSULE_GW_TLS_CERT=/certs/wildcard-apps.crt,/certs/wildcard-db.crt
CAPSULE_GW_TLS_KEY=/certs/wildcard-apps.key,/certs/wildcard-db.key

# --- Limites (derivados en docs/gateway/RESOURCES.md; ajustar tras medir en el host real) ---------------------------------------
# Conexiones abiertas en todo el proceso. Con el 443 tomado cuentan TAMBIEN las de Caddy (git, web): RESOURCES.md seccion 6.
CAPSULE_GW_MAX_CONNS=6000
# Por IP de origen: conexiones sin autenticar a la vez (100) y conexiones nuevas por segundo (20, rafaga 40). OJO con el 443: este limite se
# cuenta ANTES de saber a que SNI va la conexion, tambien para el HTTPS de git. Una oficina o CGNAT con muchos clientes detras de una IP
# puede toparlo: con el 443 tomado se sube (RUNBOOK-443.md).
CAPSULE_GW_PREAUTH_PER_IP=100
CAPSULE_GW_NEW_CONNS_PER_IP=20
# Por ruta: conexiones nuevas por segundo (100), maximo (200) y maximo por IP (50); el control puede sobrescribir los maximos.
CAPSULE_GW_ROUTE_CONN_RATE=100
CAPSULE_GW_ROUTE_MAX_CONNS=200
CAPSULE_GW_ROUTE_MAX_CONNS_PER_IP=50
# Plazos: primeros bytes / ClientHello (10s), conexion al destino (5s), inactividad tras el OK (1h; 0 = ninguna), tras un half-close (5m).
CAPSULE_GW_HELLO_TIMEOUT=10s
CAPSULE_GW_DIAL_TIMEOUT=5s
CAPSULE_GW_IDLE_TIMEOUT=1h
CAPSULE_GW_HALFCLOSE_IDLE=5m
# Tope del ClientHello y de la cabecera HTTP en claro, en bytes.
CAPSULE_GW_MAX_HELLO_BYTES=16384
CAPSULE_GW_MAX_HTTP_HEAD=16384
# Drenado al recibir SIGTERM: espera para dejar de aceptar (2s), plazo maximo para las conexiones abiertas (el compose da 30m de
# stop_grace_period: este valor debe ser menor) y SO_REUSEPORT para que el proceso nuevo tome los puertos mientras el viejo drena.
CAPSULE_GW_DRAIN_GRACE=2s
CAPSULE_GW_DRAIN_TIMEOUT=25m
CAPSULE_GW_REUSEPORT=true
# Solo para pruebas locales: permite destinos de rutas en loopback. NO activar en produccion (dest_host debe ser la IP del puente).
#CAPSULE_GW_ALLOW_LOOPBACK_DEST=1

# --- Observabilidad (PLAN 9) ---------------------------------------------------------------------------------------------------
# /metrics, /healthz y /readyz (solo loopback); el healthcheck del compose y verify.sh --host usan /readyz. Con el 443 tomado la metrica
# gw_take443_bound vale 1 cuando el gateway es el dueño del 443. "off" desactiva el endpoint.
CAPSULE_GW_METRICS_ADDR=127.0.0.1:9102
# Un JSON por conexion (sin contenido ni tokens). debug|info|warn|error
CAPSULE_GW_LOG_LEVEL=info
