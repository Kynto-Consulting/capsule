# Variables del gateway universal (contenedor capsule-gateway). Copiar a deploy/gateway/gateway.env (modo 0600, fuera de git).
# Convención: (PLAN) = nombre fijado en docs/gateway/PLAN.md; (PROPUESTA) = nombre propuesto aquí para el paquete G4/G9/G10,
# que debe implementarlo o renombrarlo y actualizar este archivo (el binario aún no existe: nada de esto está probado contra él).
# Los valores por defecto son los de la primera fase (F1): el gateway NO toma el 443.

# --- Qué escucha ---------------------------------------------------------------------------------------------------------------
# (PLAN) 1 = el gateway toma el 443 y reenvía HTTP/TLS no reconocido a Caddy (fase F2, G10). 0 = no toca el 443 (F1).
# Antes de poner 1: Caddy debe haber dejado el 443 del host (G10 edita el compose de producción; aquí no se toca).
CAPSULE_GW_TAKE_443=0

# (PROPUESTA) Puertos estándar de SNI, separados por coma. Cada uno exige su regla en el security group (gateway.tf,
# gateway_standard_ports) y que ningún otro proceso del host lo use. F1: solo 5432; MySQL/Redis/Mongo llegan en F2 (G11).
CAPSULE_GW_LISTEN_STD=5432
# (PROPUESTA) Puerto de pruebas de F1 (443 intacto). Vacío = desactivado. En el security group solo para CIDR explícitos.
CAPSULE_GW_TEST_LISTEN=:8443
# (PROPUESTA) Destino HTTP/TLS no reconocido cuando CAPSULE_GW_TAKE_443=1. Caddy debe publicarlo en loopback, p. ej.
# "127.0.0.1:8444:443" (NO 8443: es el puerto de pruebas del gateway).
CAPSULE_GW_HTTP_UPSTREAM=127.0.0.1:8444

# (PLAN) Pool de puertos aleatorios de respaldo (PLAN 3.4). Debe coincidir con gateway_pool_from/gateway_pool_to de gateway.tf
# (verify.sh lo comprueba). Distinto de 40000-41999 (puertos directos).
CAPSULE_GW_PORT_POOL=20000-29999

# (PROPUESTA) Zona de los nombres (la zona es parámetro, PLAN 3.1). El cliente usa CAPSULE_GATEWAY_ZONE (PLAN 10).
CAPSULE_GW_ZONE=tumi-ai.com

# --- Plano de control ----------------------------------------------------------------------------------------------------------
# (PROPUESTA) El backend publica 8080 en el host; el gateway (modo host) lo alcanza por loopback.
CAPSULE_GW_CONTROL_URL=http://127.0.0.1:8080
# (PROPUESTA) Secreto compartido de /internal/gateway/routes y /internal/gateway/authorize (como /internal/git-auth). Generar con
# `openssl rand -hex 32`; el MISMO valor en el backend. No reutilizar CAPSULE_GIT_AUTH_SECRET.
CAPSULE_GW_CONTROL_SECRET=
# (PROPUESTA) Tiempo de vida de la autorización cacheada de un token (PLAN 4.2: 30 s) y plazo de la tabla sin control (fail-static).
CAPSULE_GW_AUTH_CACHE_TTL=30s

# --- Certificados --------------------------------------------------------------------------------------------------------------
# (PROPUESTA) Directorio montado de solo lectura en /certs (comodín *.db / *.apps / tcp. / udp., G9). El gateway recarga al cambiar.
CAPSULE_GW_CERT_DIR=/certs

# --- Límites (derivados en docs/gateway/RESOURCES.md; ajustar tras medir en el host real) ---------------------------------------
# (PROPUESTA) Conexiones simultáneas totales y de las que el gateway termina TLS (75 KB/conexión frente a 25-28 KB en passthrough).
CAPSULE_GW_MAX_CONNS=6000
CAPSULE_GW_MAX_CONNS_TERMINATE=1500
# (PLAN 5.2) Por proyecto y por IP de origen; tasa de conexiones nuevas por segundo (IP / proyecto).
CAPSULE_GW_MAX_CONNS_PER_PROJECT=200
CAPSULE_GW_MAX_CONNS_PER_IP=50
CAPSULE_GW_NEW_CONN_RATE_PER_IP=20
CAPSULE_GW_NEW_CONN_RATE_PER_PROJECT=100
# (PLAN 5.3) Plazo para leer el encabezado/ClientHello (anti slowloris) y tope de su tamaño en bytes.
CAPSULE_GW_HEADER_TIMEOUT=5s
CAPSULE_GW_HEADER_MAX_BYTES=1024
# (PROPUESTA) Espera tras SIGTERM antes de cortar conexiones (debe ser <= stop_grace_period del compose).
CAPSULE_GW_DRAIN_TIMEOUT=25m

# --- Observabilidad (PLAN 9) ---------------------------------------------------------------------------------------------------
# (PLAN) Métricas Prometheus. Solo loopback.
CAPSULE_GW_METRICS_ADDR=127.0.0.1:9102
# (PROPUESTA) /healthz y /readyz, solo loopback; los usa el healthcheck del compose y verify.sh --host.
CAPSULE_GW_HEALTH_ADDR=127.0.0.1:9103
# (PROPUESTA) Un JSON por conexión (sin contenido ni tokens). debug|info|warn|error
CAPSULE_GW_LOG_LEVEL=info
