# Configuracion de acme-issue.sh. Copiar a deploy/gateway/acme.env (modo 0600, fuera de git). No contiene secretos.
ACME_EMAIL=piero.alarcon@labroe.com
# `terraform output -raw acme_zone_id` / `terraform output -raw acme_role_arn`
ACME_ZONE_ID=
ACME_ROLE_ARN=
# Zona de los nombres (la misma que CAPSULE_GW_ZONE).
CAPSULE_GW_ZONE=tumi-ai.com
