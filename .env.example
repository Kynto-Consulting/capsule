# ──────────────────────────────────────────────────────────────
# Capsule Backend — Environment Variables
# Copy to .env and fill in required values.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────

# Environment name: development | staging | production
CAPSULE_ENV=development

# HTTP port the backend listens on
CAPSULE_PORT=8080

# Log level: debug | info | warn | error
CAPSULE_LOG_LEVEL=info

# Secret key for JWT signing (required in all environments)
CAPSULE_SECRET_KEY=change-me-to-a-random-32-char-string

# Public-facing hostname for the API (used in DB connection URLs, etc.)
# Example: api.your-domain.com
CAPSULE_PUBLIC_HOST=

# Platform subdomain base (apps served at <slug>.CAPSULE_APPS_DOMAIN)
# Example: apps.your-domain.com
CAPSULE_APPS_DOMAIN=

# ── Database & Cache ──────────────────────────────────────────

# PostgreSQL connection URL (required)
DATABASE_URL=postgres://capsule:capsule@localhost:5432/capsule?sslmode=disable

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# ── Security & CORS ───────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# In production this is required; in development defaults to localhost:3000.
# Example: https://app.your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────

RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ── AWS ───────────────────────────────────────────────────────

AWS_DEFAULT_REGION=us-east-1

# Your 12-digit AWS account ID — used to derive default bucket names
AWS_ACCOUNT_ID=

# ECR registry URL (e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com)
ECR_REGISTRY=

# S3 bucket for deployment artifacts (defaults to capsule-artifacts-<account_id>)
ARTIFACTS_BUCKET=

# S3 bucket for static assets (defaults to capsule-static-<account_id>)
CAPSULE_STATIC_BUCKET=

# ── Infrastructure ────────────────────────────────────────────

# DNS name of the Application Load Balancer (used for custom domain CNAME)
ALB_DNS_NAME=

# RDS subnet group name for managed databases
DB_SUBNET_GROUP=capsule

# Security group ID to attach to RDS instances
RDS_SECURITY_GROUP_ID=

# Security group (id, sg-...) of the app host. Capsule manages per-database ingress rules on it
# (rules tagged "capsule:db:<id>:<cidr>"; others are never touched). Empty = the database access API returns 501.
APP_SECURITY_GROUP_ID=

# ── Deploy robustness (all optional; empty = default) ───────────────────────
# Container must stay up this many seconds before traffic switches when the project has no health_path (default 5)
CAPSULE_DEPLOY_MIN_UPTIME_SECONDS=
# Build limits. Enforced per RUN step ONLY for Dockerfiles that do not need BuildKit syntax (legacy builder);
# BuildKit-only Dockerfiles get just the timeout + concurrency gate (a warning is written to the build log).
# Suggested for the 4 GB host: 1500m. SWAP defaults to the same value (= no swap for the build).
CAPSULE_BUILD_MEMORY=
CAPSULE_BUILD_MEMORY_SWAP=
CAPSULE_BUILD_CPUS=
# Wall-clock limit of one docker build (default 30) and builds running at once (default 1)
CAPSULE_BUILD_TIMEOUT_MINUTES=
CAPSULE_BUILD_MAX_CONCURRENT=
# Optional buildx builder (docker-container driver created with --driver-opt memory=...) used for ALL builds
CAPSULE_BUILD_BUILDER=
# Scheduled cleanup of build cache + orphan images (never touches images in use or the last successful deployment's)
CAPSULE_CLEANUP_INTERVAL_HOURS=
CAPSULE_CLEANUP_CACHE_MAX_AGE_HOURS=
CAPSULE_CLEANUP_KEEP_STORAGE=
# Filesystem checked for the 80% disk alert; above CAPSULE_DISK_MAX_PERCENT (default 85) the cache is cut hard
CAPSULE_DISK_PATH=
CAPSULE_DISK_MAX_PERCENT=
